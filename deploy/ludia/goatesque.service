[Unit]
Description=Goatesque authoritative online co-op simulation
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/goatesque/current
ExecStart=/usr/bin/node --max-old-space-size=40 %h/goatesque/current/server.mjs --host 127.0.0.1 --port 8792 --public %h/goatesque/current/public
Restart=on-failure
RestartSec=3
MemoryHigh=80M
MemoryMax=96M
MemorySwapMax=0
CPUQuota=25%
TasksMax=32
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
